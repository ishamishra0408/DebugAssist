{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Bash(cat *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(less *.env)",
      "Bash(more *.env)",
      "Bash(grep * *.env)",
      "Bash(source *.env)",
      "Bash(strings *.env)",
      "Bash(xxd *.env)",
      "Bash(cp *.env *)",
      "Bash(base64 *.env)"
    ]
  }
}
