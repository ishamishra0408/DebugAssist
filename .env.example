# Copy to .env and fill in. .env is git-ignored. Never paste keys into chat.

# Claude (and cheaper models) via OpenRouter. Set a spending cap on this key in the OpenRouter dashboard.
OPENROUTER_API_KEY=

# GitHub: fine-grained token, "Public repositories (read-only)", no permissions, 30-day expiry.
# The pipeline only ever holds this READ-only token. Publishing a PR is done by you, after your go-word.
GITHUB_TOKEN_READONLY=

# Local services (docker compose up -d)
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Models
GEN_MODEL_DEV=qwen/qwen3-coder-next        # cheap, for iterating on the pipeline
GEN_MODEL_DEMO=anthropic/claude-opus-5.5   # for the real Friday/Sunday runs
EMBED_MODEL=qwen3-embedding:0.6b
LAYA_CHECKPOINT=aac6fef/laya-mlx

# Spend guardrail: the run aborts once its estimated cost passes this (USD)
RUN_BUDGET_USD=0.50

# Advisors: the Domain Expertise MCP server (advisors.py). Off unless all three are set; REVIEWED only after a review.
ADVISORS_MCP=https://domain-expertise-mcp.onrender.com/mcp/
ADVISORS_REVIEWED=
ADVISORS_KEY=

# GitHub sign-in (hosted address; optional on this Mac, where there is no sign-in without it)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ALLOWED_GITHUB_USERS=your-github-name,another-name
# Private runs and spending limits (optional): who owns runs from before owners were recorded, and each person's
# monthly AI limit (default $10), with per-person overrides
# OLDER_RUNS_OWNER=your-github-name
# SPEND_CAP_USD=10
# SPEND_CAPS=another-name=5
